{
  "name": "rmr-technology-desktop",
  "version": "0.1.0-beta.2",
  "private": true,
  "description": "RMR TECHNOLOGY Studio 2.0 - Beta de escritorio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ar.com.rmrtechnology.studio",
    "productName": "RMR TECHNOLOGY Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "aire/rmr-tecnology.html"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}